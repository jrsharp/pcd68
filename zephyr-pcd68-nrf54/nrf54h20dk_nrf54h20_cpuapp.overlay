/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * Device Tree overlay for PCD68 Model 4 CyberTerminal
 * nRF54H20-DK without display (temporarily disabled)
 */

/ {
    chosen {
        /* Display temporarily disabled */
    };

    aliases {
        /* Display temporarily disabled */
    };
    
    fstab {
        compatible = "zephyr,fstab";
        lfs1: lfs1 {
            compatible = "zephyr,fstab,littlefs";
            mount-point = "/lfs1";
            partition = <&storage_partition>;
            automount;
            read-size = <16>;
            prog-size = <16>;
            cache-size = <64>;
            lookahead-size = <32>;
            block-cycles = <512>;
        };
    };
};

/*
 * MODEL 4 CYBERTERMINAL - OPTIMIZED PARTITION LAYOUT
 * Relocates VPR cores to maximize PCD68 application space
 * Research confirmed VPR partitions are device tree configurable!
 */
&mram1x {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        /* Delete ALL default partitions to redefine layout */
        /delete-node/ partition@30000;
        /delete-node/ partition@40000;
        /delete-node/ partition@92000;
        /delete-node/ partition@e4000;
        /delete-node/ partition@f4000;
        /delete-node/ partition@100000;
        /delete-node/ partition@152000;
        /delete-node/ partition@1a4000;
        /delete-node/ partition@1ae000;

        /* BOOTLOADER - Required by system */
        boot_partition: partition@30000 {
            reg = <0x30000 DT_SIZE_K(64)>; /* 64KB @ 0x30000-0x40000 */
        };

        /* PCD68 MAIN APP - 700KB for emulation core */
        slot0_partition: partition@40000 {
            label = "image-0";
            reg = <0x40000 DT_SIZE_K(700)>; /* 700KB @ 0x40000-0xef000 */
        };

        /* PPR CORE - Relocated, minimal size */
        cpuppr_code_partition: partition@ef000 {
            reg = <0xef000 DT_SIZE_K(20)>; /* 20KB @ 0xef000-0xf4000 */
        };

        /* FLPR CORE - Keep at original location */
        cpuflpr_code_partition: partition@f4000 {
            reg = <0xf4000 DT_SIZE_K(48)>; /* 48KB @ 0xf4000-0x100000 */
        };

        /* RADIO CORE - For BLE keyboard functionality */
        cpurad_slot0_partition: partition@100000 {
            reg = <0x100000 DT_SIZE_K(256)>; /* 256KB @ 0x100000-0x140000 */
        };

        /* STORAGE - LittleFS for application data */
        storage_partition: partition@140000 {
            label = "storage";
            reg = <0x140000 DT_SIZE_K(400)>; /* 400KB @ 0x140000-0x1a4000 */
        };

        /* PERIPHERAL CONFIG - Keep original */
        periphconf_partition: partition@1a4000 {
            reg = <0x1a4000 DT_SIZE_K(40)>; /* 40KB @ 0x1a4000-0x1ae000 */
        };
    };
};

/* Use the standard slot0_partition reference */
/ {
    chosen {
        zephyr,code-partition = &slot0_partition;
    };
};

